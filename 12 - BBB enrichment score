  object = sham_selected,
  features = list(genes_bbb_present),
  name = "BBB_Munji",
  assay = "SCT",
  seed = 123
)

sham_selected$BBB_Munji_score <- sham_selected$BBB_Munji1

Idents(combined_selected) <- "seurat_clusters"

p_umap_selected <- DimPlot(combined_selected)

recluster_colors <- ggplot_build(p_umap_selected)$data[[1]] %>%
  select(group, colour) %>%
  distinct() %>%
  arrange(group) %>%
  pull(colour)

names(recluster_colors) <- levels(Idents(combined_selected))

VlnPlot(
  sham_selected,
  features = "BBB_Munji_score",
  pt.size = 0.1,
  cols = recluster_colors
) +
  theme(
    axis.title.x = element_blank(),
    axis.text.x = element_text(
      face = "bold"
    ),
    plot.title = element_text(
      size = 11,
      face = "bold"
    )
  ) +
  labs(
    title = "BBB enrichment score"
  )

bbb_score_by_cluster <- sham_selected@meta.data %>%
  group_by(seurat_clusters) %>%
  summarise(
    mean_BBB_score = mean(BBB_Munji_score, na.rm = TRUE),
    median_BBB_score = median(BBB_Munji_score, na.rm = TRUE),
    n_cells = n(),
    .groups = "drop"
  ) %>%
  arrange(desc(mean_BBB_score))

bbb_score_by_cluster

ggplot(
  bbb_score_by_cluster,
  aes(
    x = reorder(
      as.factor(seurat_clusters),
      mean_BBB_score
    ),
    y = mean_BBB_score,
    fill = as.factor(seurat_clusters)
  )
) +
  geom_col(
    width = 0.7,
    color = "black",
    alpha = 0.8
  ) +
  coord_flip() +
  scale_fill_manual(
    values = recluster_colors
  ) +
  theme_classic(base_size = 14) +
  theme(
    axis.text.y = element_text(
      face = "bold"
    ),
    legend.position = "none"
  ) +
  labs(
    title = "BBB enrichment score",
    x = "Cluster",
    y = "Mean BBB Module Score"
  )

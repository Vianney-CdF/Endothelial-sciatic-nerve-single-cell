# Keep only genes present in the SCT assay
genes_bbb_present <- intersect(
  bbb_exhaustive_munji,
  rownames(sham_selected[["SCT"]])
)

# Check missing genes
genes_bbb_missing <- setdiff(
  bbb_exhaustive_munji,
  rownames(sham_selected[["SCT"]])
)


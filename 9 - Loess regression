genes_present_custom <- intersect(
  genes_of_interest_pseudotime,
  rownames(sham_pseudotime[["SCT"]])
)

genes_missing_custom <- setdiff(
  genes_of_interest_pseudotime,
  rownames(sham_pseudotime[["SCT"]])
)

genes_missing_custom

expression_custom <- LayerData(
  sham_pseudotime,
  assay = "SCT",
  layer = "data"
)[
  genes_present_custom,
  ,
  drop = FALSE
]

plot_data_custom <- data.frame(
  Pseudotime = pseudotime_values,
  t(as.matrix(expression_custom))
) %>%
  pivot_longer(
    cols = -Pseudotime,
    names_to = "Gene",
    values_to = "Expression"
  )

  plot_smooth_custom <- plot_data_custom %>%
  group_by(Gene) %>%
  group_modify(
    ~ {
      model <- loess(
        Expression ~ Pseudotime,
        data = .x,
        span = 0.3
      )


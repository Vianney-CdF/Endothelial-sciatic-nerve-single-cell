  "Gja5", "Gja4", "Sema3g", "Clu", "Mgp", "Car4",
  "Plvap", "Slc39a8", "Pdgfc", "Mfsd2a", "Cldn5",
  "Pllp", "Sox17", "Mt1", "Mt2", "Lef1", "Cadm1",

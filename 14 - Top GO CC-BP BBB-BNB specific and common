)

run_go_enrichment <- function(
  genes,
  ontology,
  min_gs_size,
  max_gs_size,
  simplify_cutoff,
  top_n = 10
) {

  ids <- bitr(
    genes,
    fromType = "SYMBOL",
    toType = "ENTREZID",
    OrgDb = org.Mm.eg.db
  )

  entrez_ids <- unique(ids$ENTREZID)

  message(
    ontology,
    "mapped genes: ",
    length(entrez_ids),
    " / ",
    length(unique(genes))
  )

  go_result <- enrichGO(
    gene = entrez_ids,
    OrgDb = org.Mm.eg.db,
    ont = ontology,
    pvalueCutoff = 0.05,
    minGSSize = min_gs_size,
    maxGSSize = max_gs_size,
    readable = TRUE
  )

go_simple <- clusterProfiler::simplify(
    go_result,
    cutoff = simplify_cutoff,
    by = "p.adjust",
    select_fun = min
  )

  go_table <- as.data.frame(go_simple) %>%
    slice_max(
      order_by = Count,
      n = top_n,
      with_ties = FALSE
    ) %>%
    mutate(
      Description = factor(
        Description,
        levels = rev(unique(Description))
      )
    )

  return(
    list(
      ids = ids,
      go = go_result,
      go_simple = go_simple,
      table = go_table
    )
  )
}

# BBB specific
bbb_bp <- run_go_enrichment(
  genes = bbb_specific,
  ontology = "BP",
  min_gs_size = 5,
  max_gs_size = 500,
  simplify_cutoff = 0.5
)

bbb_cc <- run_go_enrichment(

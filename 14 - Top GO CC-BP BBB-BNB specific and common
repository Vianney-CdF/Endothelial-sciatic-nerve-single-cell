plot_go <- function(go_table, title, subtitle = NULL) {
ggplot(
    go_table,
    aes(
      x = Count,
      y = Description,
      fill = p.adjust
    )
  ) +
    geom_col(
      width = 0.7,
      color = "black",
      linewidth = 0.3
    ) +
    scale_fill_gradientn(
      colors = c("blue", "white", "red"),
      name = "p-adj"
    ) +
    theme_minimal() +
    theme(
      axis.text.y = element_text(
        size = 8,
        face = "bold",
        color = "black"
      ),
      panel.border = element_rect(
        colour = "black",
        fill = NA,
        linewidth = 0.5
      ),
      plot.title = element_text(
        face = "bold"
      )
    ) +
    labs(
      title = title,
      subtitle = subtitle,
      x = "Gene Count",
      y = NULL
    )
}


---
title: "BBB vs BNB Euler"
author: "Dehais Vianney"
---

bbb_genes_all <- unique(bbb_exhaustive_munji)

DefaultAssay(sham_selected) <- "SCT"

avg_expression_bnb <- AverageExpression(
  sham_selected,
  assays = "SCT",
  layer = "data",
  group.by = "condition",
  return.seurat = FALSE
)$SCT

bnb_genes <- rownames(avg_expression_bnb)[
  avg_expression_bnb[, 1] > 0.5
]

n_bbb_specific <- length(
  setdiff(bbb_genes_all, bnb_genes)
)

n_bnb_specific <- length(
  setdiff(bnb_genes, bbb_genes_all)
)

n_shared <- length(
  intersect(bbb_genes_all, bnb_genes)
)

message("BBB-only genes: ", n_bbb_specific)
message("BNB-only genes: ", n_bnb_specific)
message("Shared BBB / BNB genes: ", n_shared)

fit_euler <- eulerr::euler(
  c(
    "BBB (Munji)" = n_bbb_specific,
    "BNB (SHAM)" = n_bnb_specific,
    "BBB (Munji)&BNB (SHAM)" = n_shared
  )
)

plot(
  fit_euler,
  quantities = TRUE,
  fill = c("lightblue", "seagreen2"),
  alpha = 0.6,
  edges = list(
    lwd = 1.5,
    col = "black"
  ),
  labels = list(
    font = 2,
    cex = 1
  ),
  main = "BBB vs BNB Euler"
)

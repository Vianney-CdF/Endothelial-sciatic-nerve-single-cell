    ),
    labels = c(
      "Down in OXA",
      "Up in OXA"
    )
  ) +
  scale_y_continuous(
    labels = abs
  ) +
  theme_classic(
 base_size = 14
  ) +
  theme(
    axis.text.x = element_text(

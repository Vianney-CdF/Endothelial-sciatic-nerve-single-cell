genes_to_plot <- top_barrier_genes %>%
  arrange(
    factor(
      category,
      levels = c(
        "Junctions",
        "Transcytosis / Vesicular trafficking",
        "Transporters"
      )
    ),
    desc(max_avg_log2FC)
  ) %>%
  pull(gene) %>%
  unique()

gene_groups <- top_barrier_genes %>%
  select(gene, category) %>%
  distinct()

gene_groups$category <- factor(
  gene_groups$category,
  levels = c(
    "Junctions",
    "Transcytosis / Vesicular trafficking",
    "Transporters"
  )
)

p_barrier <- DotPlot(
  sham_sub,
  features = genes_to_plot,
  assay = "SCT",
  dot.scale = 6
) +
  RotatedAxis() +
  scale_colour_gradient2(
    low = "blue",
    mid = "white",
    high = "red",
    midpoint = 0
  )

p_barrier$data$category <- gene_groups$category[
  match(
    p_barrier$data$features.plot,
    gene_groups$gene
  )
]

final_barrier_plot <- p_barrier +
  facet_grid(
    ~category,
    scales = "free_x",
    space = "free_x"
  ) +
  theme(
    panel.spacing = unit(0.4, "lines"),

    strip.background = element_rect(
      fill = "grey95",
      color = "black"
    ),

    strip.text = element_text(
      size = 10,
      face = "bold"
    ),

    panel.border = element_rect(
      colour = "black",
      fill = NA,
      linewidth = 0.6
    ),

    axis.text.x = element_text(
      size = 8,
      face = "italic",
      angle = 45,
      hjust = 1
    ),

    axis.text.y = element_text(
      size = 10,
      face = "bold"
    ),

    axis.title = element_blank()
  ) +
  labs(
    title = "Blood-Nerve Barrier Molecular Profile - SHAM",
    color = "Relative Expression",
    size = "% Expressing"
  )

print(final_barrier_plot)

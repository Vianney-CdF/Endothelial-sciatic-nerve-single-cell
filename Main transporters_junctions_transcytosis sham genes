DefaultAssay(sham_sub) <- "SCT"

Idents(sham_sub) <- "seurat_clusters"

Idents(sham_sub) <- factor(
  Idents(sham_sub),
  levels = cluster_order
)

# Define familly gene of interest
junction_pattern <- paste0(
  "^Cldn|",
  "^Ocln|",
  "^Tjp|",
  "^F11r|",
  "^Cdh5|",
  "^Esam|",
  "^Jam|",
  "^Pecam"
)

transcytosis_pattern <- paste0(
  "^Mfsd2a|",
  "^Cav[123]|",
  "^Cavin|",
  "^Plvap|",
  "^Ehd|",
  "^Snx"
)

transporter_pattern <- "^Slc|^Abc"

junction_markers <- markers_sham_sig %>%
  filter(str_detect(gene, junction_pattern)) %>%
  mutate(category = "Junctions")

transcytosis_markers <- markers_sham_sig %>%
  filter(str_detect(gene, transcytosis_pattern)) %>%
  mutate(category = "Transcytosis / Vesicular trafficking")

transporter_markers <- markers_sham_sig %>%
  filter(str_detect(gene, transporter_pattern)) %>%
  mutate(category = "Transporters")

barrier_markers <- bind_rows(
  junction_markers,
  transcytosis_markers,
  transporter_markers
)

top_barrier_genes <- barrier_markers %>%
  group_by(category, gene) %>%
  summarise(
    max_avg_log2FC = max(avg_log2FC, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  group_by(category) %>%
  slice_max(
    order_by = max_avg_log2FC,
    n = 15,
    with_ties = FALSE
  ) %>%
  ungroup()

